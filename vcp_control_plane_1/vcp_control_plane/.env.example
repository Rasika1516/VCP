# =============================================================================
# VCP Control Plane — Environment Variables
# =============================================================================
# Copy to .env and fill in values. All vars are prefixed VCP_CP_.

# --- API ---
VCP_CP_API_HOST=0.0.0.0
VCP_CP_API_PORT=8090
VCP_CP_API_TOKEN=change-me-in-production
VCP_CP_REQUIRE_AUTH=true

# --- PostgreSQL ---
VCP_CP_DATABASE_URL=postgresql+asyncpg://vcp:vcp@localhost:5432/vcp_control

# --- Redis (must match vcp_data_plane config) ---
VCP_CP_REDIS_HOST=localhost
VCP_CP_REDIS_PORT=6379
VCP_CP_REDIS_PASSWORD=
VCP_CP_REDIS_SSL=false

# --- Command Bus (stream key prefixes — must match data plane) ---
VCP_CP_COMMAND_STREAM_PREFIX=vcp:commands:worker
VCP_CP_BROADCAST_STREAM=vcp:commands:broadcast
VCP_CP_EVENT_STREAM_PREFIX=vcp:events:worker
VCP_CP_CONSUMER_GROUP=control-plane
VCP_CP_CONSUMER_NAME=cp-01

# --- Data Plane Workers (for HTTP status queries) ---
# Comma-separated base URLs of worker control APIs
VCP_CP_WORKER_URLS=http://localhost:8080
VCP_CP_WORKER_TOKEN=

# --- Frontend CORS origin ---
VCP_CP_FRONTEND_URL=http://localhost:5173

# --- Misc ---
VCP_CP_LOG_LEVEL=INFO
VCP_CP_PROFILE_DIR=configs/profiles
